{
  "name": "slydr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, browser-based slide show player for folders of images.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names \"shared,api,web\" --prefix-colors \"yellow,cyan,magenta\" \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:shared": "tsc -p shared/tsconfig.build.json --watch --preserveWatchOutput",
    "dev:server": "npm run dev --workspace @slydr/server",
    "dev:client": "npm run dev --workspace @slydr/client -- --open",
    "size:client": "node scripts/check-client-size.mjs",
    "build": "npm run typecheck && npm run build -w @slydr/shared && npm run build -w @slydr/server --if-present && npm run build -w @slydr/client --if-present",
    "start": "node server/dist/index.js --open",
    "check:bundle": "npm run size:client",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test": "npm run build -w @slydr/shared && vitest run",
    "test:watch": "npm run build -w @slydr/shared && vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @slydr/shared && tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
