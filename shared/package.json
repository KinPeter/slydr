{
  "name": "@slydr/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, constants and pure helpers for Slydr. No runtime dependencies.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
